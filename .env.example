# Copy to .env (or run: python setup.py) and fill in. Never commit .env.

# --- Required -------------------------------------------------------------
# Studio sign-in. Prefer a hash: python -m blox.cli hash-password
ADMIN_PASSWORD_HASH=
# ...or a plain password (12+ characters) if you do not use the hash:
ADMIN_PASSWORD=replace-with-a-unique-password
# Flask session signing key (python -c "import secrets; print(secrets.token_urlsafe(48))")
SESSION_SECRET=replace-with-random-value-at-least-32-characters
# Password for the bundled PostgreSQL service (compose.yaml)
POSTGRES_PASSWORD=replace-with-a-database-password

# --- Network --------------------------------------------------------------
# The URL you open the studio at. Used for the Google OAuth redirect URI:
#   <PUBLIC_URL>/oauth/callback
PUBLIC_URL=http://localhost:8000
# Set 1 when serving over HTTPS (behind your reverse proxy).
COOKIE_SECURE=0
# Number of reverse proxies in front of the app that set X-Forwarded-* (0 = none).
TRUSTED_PROXIES=0

# --- Storage --------------------------------------------------------------
# Leave empty to use SQLite in ./data (single machine). compose.yaml sets PostgreSQL.
# DATABASE_URL=postgresql://user:password@host:5432/blox
# Encryption key for stored credentials. If empty, a key file is created at data/vault.key.
# Back it up: without it, saved credentials cannot be decrypted.
BLOX_VAULT_KEY=

# --- Tools (defaults suit the Docker image) -------------------------------
# BLENDER_BIN=blender
# FFMPEG_BIN=ffmpeg
# FFPROBE_BIN=ffprobe
# BLOX_BLENDER_TIMEOUT_S=5400

# --- Provider credentials -------------------------------------------------
# Optional here: you can enter them on the Connections page instead (stored encrypted).
OPENAI_API_KEY=
YOUTUBE_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
RUNWAYML_API_SECRET=
ELEVENLABS_API_KEY=
# Authorized transcript provider you have a licence for (optional, https only)
TRANSCRIPT_PROVIDER_URL=
TRANSCRIPT_PROVIDER_KEY=
